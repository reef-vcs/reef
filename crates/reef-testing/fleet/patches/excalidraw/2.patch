+/**
+ * Whether two bounding boxes intersect. Boxes that only touch count as
+ * intersecting. A positive `tolerance` grows `a` on every side, so boxes
+ * that are at most `tolerance` apart also count.
+ */
+export function doBBoxesIntersect(a: Bounds, b: Bounds, tolerance = 0) {
+  return (
+    a[0] - tolerance <= b[2] &&
+    a[2] + tolerance >= b[0] &&
+    a[1] - tolerance <= b[3] &&
+    a[3] + tolerance >= b[1]
+  );
 }
 
 const EPSILON = 0.000001;
