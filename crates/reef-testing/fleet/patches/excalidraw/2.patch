+import type { Bounds } from "@excalidraw/excalidraw/element/bounds";
+import { pointFrom, type GlobalPoint } from "@excalidraw/math";
+import { doBBoxesIntersect, doLineSegmentsIntersect } from "./bbox";
+
+const box = (
+  minX: number,
+  minY: number,
+  maxX: number,
+  maxY: number,
+): Bounds => [minX, minY, maxX, maxY];
+
+describe("doBBoxesIntersect()", () => {
+  it("should detect overlapping and touching boxes", () => {
+    expect(doBBoxesIntersect(box(0, 0, 10, 10), box(5, 5, 15, 15))).toBe(true);
+    expect(doBBoxesIntersect(box(0, 0, 10, 10), box(10, 0, 20, 10))).toBe(true);
+  });
+
+  it("should reject separate boxes without a tolerance", () => {
+    expect(doBBoxesIntersect(box(0, 0, 10, 10), box(12, 0, 20, 10))).toBe(
+      false,
+    );
+  });
+
+  it("should accept nearby boxes within the tolerance", () => {
+    expect(doBBoxesIntersect(box(0, 0, 10, 10), box(12, 0, 20, 10), 2)).toBe(
+      true,
+    );
+    expect(doBBoxesIntersect(box(0, 0, 10, 10), box(13, 0, 20, 10), 2)).toBe(
+      false,
+    );
+  });
+});
+
+describe("doLineSegmentsIntersect()", () => {
+  it("should detect crossing segments", () => {
+    const a = [
+      pointFrom<GlobalPoint>(0, 0),
+      pointFrom<GlobalPoint>(10, 10),
+    ] as [GlobalPoint, GlobalPoint];
+    const b = [
+      pointFrom<GlobalPoint>(0, 10),
+      pointFrom<GlobalPoint>(10, 0),
+    ] as [GlobalPoint, GlobalPoint];
+    expect(doLineSegmentsIntersect(a, b)).toBe(true);
+  });
+});
