@@ -80,3 +80,17 @@ export const rangeIncludesValue = (
 ): boolean => {
   return value >= min && value <= max;
 };
+
+/**
+ * Clamp a value so that it falls inside the given range.
+ *
+ * @param value The value to clamp
+ * @param range The range to clamp to
+ * @returns The value itself if inside the range, otherwise the nearest bound
+ */
+export const rangeClamp = (
+  value: number,
+  [min, max]: InclusiveRange,
+): number => {
+  return Math.min(Math.max(value, min), max);
+};
