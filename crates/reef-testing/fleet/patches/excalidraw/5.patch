diff --git a/excalidraw-app/data/index.test.ts b/excalidraw-app/data/index.test.ts
new file mode 100644
index 000000000..b0f38c707
--- /dev/null
+++ b/excalidraw-app/data/index.test.ts
@@ -0,0 +1,23 @@
+import { isCollaborationLink } from ".";
+
+describe("isCollaborationLink", () => {
+  it("should accept room links", () => {
+    expect(
+      isCollaborationLink(
+        "https://excalidraw.com/#room=0123456789abcdef0123,abcdefghijklmnopqrstuv",
+      ),
+    ).toBe(true);
+  });
+
+  it("should reject links without a room", () => {
+    expect(isCollaborationLink("https://excalidraw.com/")).toBe(false);
+    expect(isCollaborationLink("https://excalidraw.com/#json=abc,def")).toBe(
+      false,
+    );
+  });
+
+  it("should reject text that is not a URL instead of throwing", () => {
+    expect(isCollaborationLink("not a link")).toBe(false);
+    expect(isCollaborationLink("")).toBe(false);
+  });
+});
