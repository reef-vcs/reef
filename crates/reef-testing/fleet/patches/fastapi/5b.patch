diff --git a/fastapi/datastructures.py b/fastapi/datastructures.py
index 7e9eb6c1e..d6208deb4 100644
--- a/fastapi/datastructures.py
+++ b/fastapi/datastructures.py
@@ -168,6 +168,10 @@ class DefaultPlaceholder:
         return isinstance(o, DefaultPlaceholder) and o.value == self.value
 
     def __repr__(self) -> str:
+        """
+        Show the wrapped value, as `Default(...)`, so that route and app
+        settings that were never overridden are easy to spot when debugging.
+        """
         return f"Default({self.value!r})"
 
 
