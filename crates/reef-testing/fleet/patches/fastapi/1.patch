@@ -0,0 +1,20 @@
+import pytest
+from fastapi.utils import is_body_allowed_for_status_code
+
+
+@pytest.mark.parametrize(
+    "status_code",
+    [None, 200, "200", 201, 404, "500", "default", "2XX", "4XX"],
+)
+def test_body_allowed(status_code):
+    assert is_body_allowed_for_status_code(status_code) is True
+
+
+@pytest.mark.parametrize("status_code", [100, 101, "199", 204, "205", 304])
+def test_body_not_allowed(status_code):
+    assert is_body_allowed_for_status_code(status_code) is False
+
+
+@pytest.mark.parametrize("status_code", ["2xx", "5xx", " 3XX ", "Default"])
+def test_body_allowed_for_ranges_in_any_case(status_code):
+    assert is_body_allowed_for_status_code(status_code) is True
