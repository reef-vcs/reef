+
+def test_title_html_chars_are_escaped():
+    html = get_swagger_ui_html(
+        openapi_url="/openapi.json",
+        title="Docs</title><script>alert(1)</script>",
+    )
+    body = bytes(html.body).decode()
+    assert "<script>alert(1)</script>" not in body
+    assert "<title>Docs&lt;/title&gt;&lt;script&gt;" in body
+
+
+def test_title_ampersand_is_escaped():
+    html = get_swagger_ui_html(openapi_url="/openapi.json", title="R&D API")
+    body = bytes(html.body).decode()
+    assert "<title>R&amp;D API</title>" in body
