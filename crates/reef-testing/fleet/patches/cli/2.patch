@@ -36,6 +36,15 @@ func FullName(r Interface) string {
 	return fmt.Sprintf("%s/%s", r.RepoOwner(), r.RepoName())
 }
 
+// FullNameWithHost serializes a GitHub repository into "OWNER/REPO" when it lives on the
+// default host and into "HOST/OWNER/REPO" otherwise, a form FromFullName parses back.
+func FullNameWithHost(r Interface) string {
+	if host := normalizeHostname(r.RepoHost()); host != ghinstance.Default() {
+		return fmt.Sprintf("%s/%s", host, FullName(r))
+	}
+	return FullName(r)
+}
+
 func defaultHost() string {
 	host, _ := ghauth.DefaultHost()
 	return host
