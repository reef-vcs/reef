+func TestFullNameWithHost(t *testing.T) {
+	tests := []struct {
+		name string
+		repo Interface
+		want string
+	}{
+		{name: "default host", repo: NewWithHost("owner", "repo", "github.com"), want: "owner/repo"},
+		{name: "enterprise host", repo: NewWithHost("owner", "repo", "example.org"), want: "example.org/owner/repo"},
+		{name: "tenancy host", repo: NewWithHost("owner", "repo", "tenant.ghe.com"), want: "tenant.ghe.com/owner/repo"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := FullNameWithHost(tt.repo)
+			if got != tt.want {
+				t.Errorf("FullNameWithHost() = %q, want %q", got, tt.want)
+			}
+			parsed, err := FromFullNameWithHost(got, "github.com")
+			if err != nil {
+				t.Fatalf("FromFullNameWithHost(%q) error: %v", got, err)
+			}
+			if !IsSame(parsed, tt.repo) {
+				t.Errorf("round trip of %q gave %q", got, FullNameWithHost(parsed))
+			}
+		})
+	}
+}
