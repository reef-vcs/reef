+	// future; a whole day ahead must not fall through to the date format either.
 	now := time.Date(2020, time.November, 22, 14, 0, 0, 0, time.UTC)
-	for _, d := range []time.Duration{time.Second, 5 * time.Minute, 3 * time.Hour} {
