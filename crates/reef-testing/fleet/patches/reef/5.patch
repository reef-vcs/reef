+//! A fleet benchmark ticket (#264): an add-only test, so it applies at any commit.
+
+fn checksum(bytes: &[u8]) -> u32 {
+    bytes.iter().fold(5_u32, |acc, b| acc.wrapping_mul(31).wrapping_add(u32::from(*b)))
+}
+
+#[test]
+fn checksum_is_stable() {
+    assert_eq!(checksum(b""), 5);
+    assert_ne!(checksum(b"reef"), checksum(b"feer"));
+}
