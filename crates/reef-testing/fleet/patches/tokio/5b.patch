+async fn test_stream_mock_next_all_empty() {
+    let mut stream_mock = StreamMockBuilder::new()
+        .next_all(Vec::<u32>::new())
+        .next(7)
+        .build();
+
+    assert_eq!(stream_mock.next().await, Some(7));
+    assert_eq!(stream_mock.next().await, None);
+}
