+#[tokio::test(start_paused = true)]
+async fn remaining_follows_reset() {
+    let sleep = time::sleep(ms(100));
+    tokio::pin!(sleep);
+
+    sleep.as_mut().reset(Instant::now() + ms(250));
+    assert_eq!(sleep.remaining(), ms(250));
+}
