+#[tokio::test(start_paused = true)]
+async fn remaining_counts_down() {
+    let sleep = time::sleep(ms(100));
+    tokio::pin!(sleep);
+
+    assert_eq!(sleep.remaining(), ms(100));
+
+    time::advance(ms(40)).await;
+    assert_eq!(sleep.remaining(), ms(60));
+
+    time::advance(ms(100)).await;
+    assert_eq!(sleep.remaining(), Duration::ZERO);
+    sleep.await;
+}
