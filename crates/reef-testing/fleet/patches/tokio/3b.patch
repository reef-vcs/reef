+#[test]
+fn lines_decoder_unbounded_never_discards() {
+    let mut codec = LinesCodec::new();
+    let buf = &mut BytesMut::new();
+
+    buf.put_slice(&[b'a'; 4096]);
+    assert_eq!(None, codec.decode(buf).unwrap());
+    assert!(!codec.is_discarding());
+}
