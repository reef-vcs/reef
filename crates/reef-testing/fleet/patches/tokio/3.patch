+#[test]
+fn lines_decoder_reports_discarding() {
+    let mut codec = LinesCodec::new_with_max_length(3);
+    let buf = &mut BytesMut::new();
+
+    buf.put_slice(b"toolong");
+    assert!(!codec.is_discarding());
+    assert!(codec.decode(buf).is_err());
+    assert!(codec.is_discarding());
+
+    buf.put_slice(b"line\nok\n");
+    assert_eq!("ok", codec.decode(buf).unwrap().unwrap());
+    assert!(!codec.is_discarding());
+}
