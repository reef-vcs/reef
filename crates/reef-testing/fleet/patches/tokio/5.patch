+#[tokio::test]
+async fn test_stream_mock_next_all() {
+    let mut stream_mock = StreamMockBuilder::new().next(1).next_all([2, 3]).build();
+
+    assert_eq!(stream_mock.next().await, Some(1));
+    assert_eq!(stream_mock.next().await, Some(2));
+    assert_eq!(stream_mock.next().await, Some(3));
+    assert_eq!(stream_mock.next().await, None);
+}
