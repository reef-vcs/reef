                THEN lock' = p /\ wentBack' = [wentBack EXCEPT ![p] = TRUE]
                     /\ Goto(p, "goback")
                ELSE Goto(p, "idle") /\ UNCHANGED <<lock, wentBack>>
===
         THEN Goto(p, "idle") /\ UNCHANGED <<lock, wentBack>>
>>>
