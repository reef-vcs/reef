# fixes: F3
# A reclaim that finds no entry for a row that is not finished and whose
# directory is gone runs reclaim_missing again, instead of NotLoaded.
<<<
Entry(p) ==
    /\ pc[p] = "entry"
===
MissingRow == ~loaded /\ ~dir /\ dbState \in {"active", "releasing"}

Entry(p) ==
    /\ pc[p] = "entry" /\ ~MissingRow
>>>
<<<
Reclaim(p) ==
    \/ Entry(p) \/ WaitLock(p) \/ GoBack(p) \/ Check(p) \/ Begin(p)
===
RetryMissing(p) ==
    /\ pc[p] = "entry" /\ MissingRow
    /\ Goto(p, "idle") /\ stateDir' = FALSE /\ jjws' = FALSE
    /\ \/ dbState' = "reclaimed" /\ lease' = "ended" /\ UNCHANGED failLeft
       \/ Fail /\ UNCHANGED <<dbState, lease>>
    /\ UNCHANGED <<up, entry, lock, dir, wentBack, env, crashLeft, quiesceLeft>>

Reclaim(p) ==
    \/ Entry(p) \/ RetryMissing(p) \/ WaitLock(p) \/ GoBack(p) \/ Check(p)
    \/ Begin(p)
>>>
