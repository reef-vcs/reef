{
  "name": "reef-vcs",
  "version": "0.0.0-dev",
  "description": "The TypeScript SDK for Reef: a typed client for the reef daemon's API, with a workspace block that holds a lease and reports presence.",
  "keywords": [
    "reef",
    "jj",
    "git",
    "vcs",
    "workspace",
    "agents",
    "grpc"
  ],
  "homepage": "https://github.com/reef-vcs/reef/blob/main/docs/typescript-sdk.md",
  "bugs": "https://github.com/reef-vcs/reef/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reef-vcs/reef.git",
    "directory": "sdk/typescript"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api/v1": {
      "types": "./dist/api/v1.d.ts",
      "default": "./dist/api/v1.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "gen": "node codegen/generate.mjs",
    "prebuild": "npm run gen",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run gen",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prelint": "npm run gen",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "pretest": "npm run build",
    "test": "vitest run --project unit",
    "pretest:integration": "npm run gen",
    "test:integration": "vitest run --project integration",
    "pack": "node scripts/pack.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@bufbuild/protoplugin": "2.16.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
