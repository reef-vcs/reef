{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reef",
  "identifier": "io.github.reef-vcs.reef",
  "build": { "frontendDist": "dist" },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Version control for fleets of coding agents",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["reef"] } }
  }
}
